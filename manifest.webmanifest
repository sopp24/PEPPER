{
  "id": "/PEPPER/",
  "name": "PEPPER — Travel Companion",
  "short_name": "PEPPER",
  "description": "Compagnon de voyage avant, pendant et après le séjour : itinéraire, réservations, transports et carte interactive.",
  "lang": "fr-FR",
  "start_url": "/PEPPER/?from=sopp-agents",
  "scope": "/PEPPER/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#090a0c",
  "theme_color": "#090a0c",
  "icons": [
    {
      "src": "./assets/pepper-favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./assets/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
